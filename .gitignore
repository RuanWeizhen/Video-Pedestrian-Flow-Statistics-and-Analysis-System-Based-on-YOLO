# ------------------------------
# Python cache / bytecode
# ------------------------------
__pycache__/
*.py[cod]
*$py.class

# ------------------------------
# Virtual environments
# ------------------------------
.venv/
venv/
env/
ENV/

# ------------------------------
# IDE / editor
# ------------------------------
.vscode/
.idea/
*.code-workspace

# ------------------------------
# OS junk
# ------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------
# Logs / temp
# ------------------------------
*.log
logs/
*.tmp
*.temp

# ------------------------------
# Build / packaging
# ------------------------------
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ------------------------------
# YOLO / training outputs
# ------------------------------
runs/
**/runs/
outputs/
**/outputs/

# ------------------------------
# Datasets and generated media
# Keep labels if you need versioning, ignore heavy assets.
# ------------------------------
# Ignore bundled or downloaded datasets in dependency trees
ultralytics-8.3.163/datasets/

# Ignore raw media generated/collected by this project
make_dataset/images/**
make_dataset/videos/**

# Ignore heavy media files only inside dataset-like paths
**/datasets/**/*.mp4
**/datasets/**/*.avi
**/datasets/**/*.mov
**/datasets/**/*.mkv
**/datasets/**/*.webm
**/datasets/**/*.jpg
**/datasets/**/*.jpeg
**/datasets/**/*.png
**/datasets/**/*.bmp
**/datasets/**/*.tif
**/datasets/**/*.tiff

# Keep annotation text files (labels)
!make_dataset/lables/**
!**/datasets/**/labels/**
!**/datasets/**/*.txt

# ------------------------------
# Model weights / checkpoints (usually large)
# ------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.tflite
*.pb
*.weights
*.partial

# ------------------------------
# Archives
# ------------------------------
*.zip
*.rar
*.7z
*.tar
*.gz

# ------------------------------
# Optional: if you want to keep a specific weight file, uncomment:
# !yolo11n.pt
# ------------------------------

# ------------------------------
# Strict sample-data mode
# Keep only lightweight metadata/config files in sample-data directories.
# ------------------------------
**/datasets/**
!**/datasets/**/
!**/datasets/**/*.yaml
!**/datasets/**/*.yml
!**/datasets/**/*.json
!**/datasets/**/*.txt

**/data/**
!**/data/**/
!**/data/**/*.yaml
!**/data/**/*.yml
!**/data/**/*.json
!**/data/**/*.txt

**/samples/**
!**/samples/**/
!**/samples/**/*.yaml
!**/samples/**/*.yml
!**/samples/**/*.json
!**/samples/**/*.txt

# ------------------------------
# Local runtime artifacts
# ------------------------------
**/traffic.db
**/ema90_best_metrics_table.csv
**/pedestrian_system/tools/test_frame.jpg
**/pedestrian_system/videos/

**/sample/**
!**/sample/**/
!**/sample/**/*.yaml
!**/sample/**/*.yml
!**/sample/**/*.json
!**/sample/**/*.txt
